# Base URL of the TRACE Rust API (no trailing slash, no /v1)
NEXT_PUBLIC_TRACE_API_URL=https://trace-api-dapper.onrender.com
# Set to 1 to always serve labelled DEMO fixtures without calling the API
NEXT_PUBLIC_TRACE_DEMO=
# Google Identity Services web client id. Leave empty to show passkey sign-in only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
