# Base URL of the TRACE Rust API (no trailing slash, no /v1)
NEXT_PUBLIC_TRACE_API_URL=http://localhost:8080
# Set to 1 to always serve labelled DEMO fixtures without calling the API
NEXT_PUBLIC_TRACE_DEMO=
# Google Identity Services web client id (sign-in is disabled when empty)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
