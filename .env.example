# Nonsecret local placeholders. Copy to .env. Never commit real secrets.
DATABASE_URL=postgres://trace:trace@localhost:5432/trace
TRACE_BIND_ADDR=127.0.0.1:8080
TRACE_DB_MAX_CONNECTIONS=10
TRACE_CORS_ORIGINS=http://localhost:3000
RUST_LOG=info,sqlx=warn

# Production (set in your host's secret store, never in git). See docs/deploy.md.
# TRACE_ENV=production
# GOOGLE_CLIENT_ID=
# TRACE_OPS_TOKEN=            # 24+ chars; enables /v1/ops/metrics
# TRACE_RPC_ETHEREUM=         # RPC URLs often contain an API key
# TRACE_RPC_SOLANA=
# TRACE_PRICE_PROVIDER=defillama
# TRACE_PRICE_API_BASE=
